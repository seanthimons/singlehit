# Root-local workspace policy. Ignore every dot file and dot folder in the project
# root (.claude/, .planning/, .beans/, .worktrees/, .Renviron, .Rhistory) and every
# root markdown file (AGENTS.md, CLAUDE.md, HANDOFF.md, session notes) without
# naming them. Add a specific !/<name> rule to opt a file into the repository.
/.*
/*.md
!/.github
!/README.md
!/NEWS.md
!/TODO.md
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/.Rbuildignore

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# Example code in package build process
*-Ex.R

# Produced vignettes
vignettes/*.html
vignettes/*.pdf

# knitr and R Markdown cache directories
*_cache/
/cache/

# Temporary files created by R Markdown
*.utf8.md
*.knit.md

# pkgdown site
docs/

# Local-only development artifacts and source data (kept out of the public repo)
/dev/
/data/raw/QMRA wiki data_v4.xlsx

# Translation temp files
po/*~

# RStudio Connect folder
rsconnect/

/.quarto/

# renv scaffolding in the package root crashes pak-based CI; keep it local-only
renv/
renv.lock
.Rprofile
